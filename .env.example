# ── LLM (Ollama) ─────────────────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# ── STT (Faster-Whisper) ──────────────────────────────────────────────────────
# Model: tiny, base, small, medium, large-v3
WHISPER_MODEL=large-v3
# Device: cuda (GPU) or cpu
WHISPER_DEVICE=cuda
# Compute type: float16 (GPU), int8 (CPU)
WHISPER_COMPUTE_TYPE=float16
WHISPER_BEAM_SIZE=1

# ── TTS (Piper) ───────────────────────────────────────────────────────────────
PIPER_BINARY=piper
PIPER_MODEL_PATH=/models/ja_JP-kana-medium.onnx

# ── ChromaDB ─────────────────────────────────────────────────────────────────
# Leave CHROMA_HOST empty to use local PersistentClient (recommended for dev)
CHROMA_HOST=
CHROMA_PORT=8001
CHROMA_PATH=/data/chroma

# ── SQLite ───────────────────────────────────────────────────────────────────
SQLITE_PATH=/data/aki.db

# ── Learning settings ─────────────────────────────────────────────────────────
DEFAULT_GRAMMAR_LEVEL=N5

# ── VAD ──────────────────────────────────────────────────────────────────────
VAD_THRESHOLD=0.5
VAD_SILENCE_MS=300
